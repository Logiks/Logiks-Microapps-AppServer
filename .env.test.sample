# Copy to .env.test (gitignored) and adjust for the instance you want to
# revalidate. Not loaded automatically - see tests/README.md for how to load
# it (eg. `env $(cat .env.test | xargs) npm test`, or your own dotenv step).

# Base URL of the AppServer instance the tests/http suite should hit.
# Defaults to http://localhost:${PORT in .env} if unset.
TEST_BASE_URL=http://localhost:9999

# Credentials for a user the auth/me suites can log in as.
# Defaults to admin/admin123 (the same local dev default test-api.sh uses).
TEST_USERNAME=admin
TEST_PASSWORD=admin123
