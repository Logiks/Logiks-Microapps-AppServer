NODE_ENV=production
SERVER_ID=server-01
RUN_MODE=server
PORT=9999
HOST=0.0.0.0
# Secrets: the server refuses to start outside NODE_ENV=development while any of these is missing, short or still a REPLACE_ME value.
# Generate each one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENC_SALT is part of every stored password hash. Set it once and never change it for an existing database.
ENC_SALT=REPLACE_ME_random_hex
CLUSTER_TOKEN=REPLACE_ME_random_hex
CLUSTER_CACHE=true
CLUSTER_CACHE_TTL=60
CORE_LOGGER_LEVEL=error
SERVER_CONSOLE_LOG_LEVEL=error
TRANSPARENT_LOGGER=true
TRANSPORTER_SERIALIZER=Notepack
TRANSPORTER=redis://127.0.0.1:6379
TRANSPORTER1=redis://192.168.0.21:6379
CONFIG_TYPE=LOCAL
CONFIG_FILE=./config.json
TEMP_CONFIG_TYPE=REMOTE
TEMP_CONFIG_FILE=http://localhost:53321/config.json
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SESSION_SECRET=REPLACE_ME_random_hex
MIGRATION_MODE=EXPORT
BULKHEAD_CONCURRENCY=50
BULKHEAD_MAX_QUEUE=500
REQUEST_TIMEOUT_MS=15000
RETRY_COUNT=2
LB_STRATEGY=CpuUsage
METRICS_ENABLED=false
MOLECULER_FILE_LOG_LEVEL=warn